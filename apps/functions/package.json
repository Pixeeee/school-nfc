
{
  "name": "@school-nfc/functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node22 --out-dir lib --clean --sourcemap --external firebase-admin --external firebase-functions",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "@school-nfc/contracts": "workspace:*",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
