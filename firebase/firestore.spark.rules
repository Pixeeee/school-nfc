rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(school) {
      return get(/databases/$(database)/documents/schools/$(school)/members/$(request.auth.uid)).data;
    }
    function active(school) {
      return request.auth != null && member(school).status == 'ACTIVE';
    }
    function teacher(school) {
      return active(school) && member(school).role in ['TEACHER', 'SCHOOL_ADMIN'];
    }
    function teacherWrite(school) { return active(school) && member(school).role == 'TEACHER'; }
    function admin(school) { return active(school) && member(school).role == 'SCHOOL_ADMIN'; }
    function device(school, id) {
      return teacher(school) && text(id, 120);
    }
    function section(school, id) {
      let s = get(/databases/$(database)/documents/schools/$(school)/sparkSections/$(id)).data;
      return teacher(school) && s.active == true && (s.get('adviserId', s.teacherId) == request.auth.uid || request.auth.uid in s.get('subjectTeacherIds', []) || admin(school));
    }
    function adviser(school, id) {
      let s = get(/databases/$(database)/documents/schools/$(school)/sparkSections/$(id)).data;
      return teacher(school) && s.active == true && s.get('classKind', 'ADVISORY') != 'SUBJECT' && (s.get('adviserId', s.teacherId) == request.auth.uid || admin(school));
    }
    function subjectTeacher(school, id, sectionId) {
      let s = get(/databases/$(database)/documents/schools/$(school)/sparkSubjects/$(id)).data;
      return teacher(school) && s.active == true && s.sectionId == sectionId && s.teacherId == request.auth.uid;
    }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function iso(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$'); }
    function nullableIso(value) { return value == null || iso(value); }
    match /schools/{school} {
      allow get: if active(school);
      match /members/{uid} { allow get: if active(school) && uid == request.auth.uid; }
      match /teacherSmsProfiles/{uid} {
        function identity(value, max) {
          return text(value, max) && value.matches('.*\\S.*') && value.matches('^[^\\x00-\\x1F\\x7F-\\x9F]+$');
        }
        allow get: if teacher(school) && uid == request.auth.uid;
        allow create, update: if teacher(school) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['username', 'schoolName', 'attendanceTemplate', 'dismissalTemplate', 'updatedAt'])
          && identity(request.resource.data.username, 60) && identity(request.resource.data.schoolName, 100)
          && request.resource.data.get('attendanceTemplate', '') is string && request.resource.data.get('attendanceTemplate', '').size() <= 600
          && request.resource.data.get('dismissalTemplate', '') is string && request.resource.data.get('dismissalTemplate', '').size() <= 600
          && request.resource.data.updatedAt == request.time;
      }
      match /academicYears/{id} { allow read: if active(school); }
      match /gradeLevels/{id} { allow read: if active(school); }
      match /smsTemplates/{id} { allow read: if active(school); }
      match /students/{id} { allow read: if section(school, resource.data.sectionId); }
      match /nfcCards/{id} { allow read: if section(school, resource.data.sectionId); }
      match /sparkDevices/{id} {
        allow get: if teacher(school) && (!exists(/databases/$(database)/documents/schools/$(school)/sparkDevices/$(id)) || resource.data.assignedUserId == request.auth.uid || admin(school));
        allow list: if admin(school);
        allow create: if teacherWrite(school) && request.resource.data.keys().hasOnly(['assignedUserId', 'displayName', 'status', 'createdAt', 'leaseExpiresAt'])
          && request.resource.data.assignedUserId == request.auth.uid && text(request.resource.data.displayName, 120)
          && request.resource.data.status == 'PENDING' && request.resource.data.createdAt == request.time
          && request.resource.data.leaseExpiresAt is timestamp && request.resource.data.leaseExpiresAt < request.time;
        allow update: if teacherWrite(school) && resource.data.assignedUserId == request.auth.uid && resource.data.status == 'APPROVED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaseExpiresAt'])
          && request.resource.data.leaseExpiresAt > request.time && request.resource.data.leaseExpiresAt <= request.time + duration.value(7, 'd');
      }
      match /sparkSections/{id} {
        allow get: if teacher(school) && (!exists(/databases/$(database)/documents/schools/$(school)/sparkSections/$(id)) || resource.data.teacherId == request.auth.uid || resource.data.get('adviserId', '') == request.auth.uid || request.auth.uid in resource.data.get('subjectTeacherIds', []) || admin(school));
        allow list: if teacher(school) && (resource.data.teacherId == request.auth.uid || resource.data.get('adviserId', '') == request.auth.uid || request.auth.uid in resource.data.get('subjectTeacherIds', []) || admin(school));
        allow create: if teacherWrite(school) && request.resource.data.keys().hasOnly(['name', 'gradeLevelId', 'academicYearId', 'teacherId', 'adviserId', 'active', 'deviceId', 'createdAt'])
          && text(request.resource.data.name, 80) && request.resource.data.teacherId == request.auth.uid && request.resource.data.get('adviserId', request.auth.uid) == request.auth.uid
          && request.resource.data.active == true && request.resource.data.createdAt == request.time && device(school, request.resource.data.deviceId)
          && get(/databases/$(database)/documents/schools/$(school)/academicYears/$(request.resource.data.academicYearId)).data.active == true
          && get(/databases/$(database)/documents/schools/$(school)/gradeLevels/$(request.resource.data.gradeLevelId)).data.active == true;
      }
      match /sparkSubjects/{id} {
        allow read: if teacher(school) && (resource.data.teacherId == request.auth.uid || adviser(school, resource.data.sectionId));
        allow update: if teacherWrite(school) && resource.data.teacherId == request.auth.uid && section(school, resource.data.sectionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'startTime', 'endTime'])
          && text(request.resource.data.name, 80)
          && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.startTime < request.resource.data.endTime;
      }
      match /sparkDismissals/{id} {
        allow get: if teacher(school) && (!exists(/databases/$(database)/documents/schools/$(school)/sparkDismissals/$(id)) || adviser(school, resource.data.sectionId));
        allow create: if teacherWrite(school) && adviser(school, request.resource.data.sectionId) && request.resource.data.keys().hasOnly(['sectionId', 'localSchoolDate', 'teacherId', 'deviceId', 'localTimestamp', 'createdAt', 'studentIds'])
          && request.resource.data.teacherId == request.auth.uid && device(school, request.resource.data.deviceId)
          && request.resource.data.studentIds is list && request.resource.data.studentIds.size() <= 500
          && request.resource.data.localSchoolDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && id == request.resource.data.sectionId + '_' + request.resource.data.localSchoolDate
          && iso(request.resource.data.localTimestamp) && request.resource.data.createdAt == request.time;
      }
      match /sparkStudents/{id} {
        allow get: if teacher(school) && (!exists(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(id)) || section(school, resource.data.sectionId));
        allow list: if section(school, resource.data.sectionId);
        allow create: if teacherWrite(school) && get(/databases/$(database)/documents/schools/$(school)/sparkSections/$(request.resource.data.sectionId)).data.get('classKind', 'LEGACY') == 'LEGACY' && adviser(school, request.resource.data.sectionId) && device(school, request.resource.data.deviceId)
          && request.resource.data.keys().hasOnly(['sectionId', 'studentNumber', 'firstName', 'lastName', 'displayName', 'parentName', 'parentPhone', 'parentPhoneVerified', 'parentConsent', 'status', 'createdBy', 'deviceId', 'createdAt'])
          && request.resource.data.studentNumber is string && request.resource.data.studentNumber.matches('^[A-Z0-9][A-Z0-9_-]{0,39}$')
          && text(request.resource.data.firstName, 120) && text(request.resource.data.lastName, 120) && text(request.resource.data.parentName, 120)
          && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
          && request.resource.data.parentPhone is string && request.resource.data.parentPhone.matches('^\\+639[0-9]{9}$')
          && request.resource.data.parentPhoneVerified == true && request.resource.data.parentConsent == true
          && request.resource.data.status == 'ACTIVE' && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/schools/$(school)/sparkStudentNumbers/$(request.resource.data.studentNumber))
          && getAfter(/databases/$(database)/documents/schools/$(school)/sparkStudentNumbers/$(request.resource.data.studentNumber)).data == {'studentId': id, 'sectionId': request.resource.data.sectionId};
      }
      match /sparkStudentNumbers/{number} {
        allow get: if teacher(school);
        allow create: if teacherWrite(school) && request.resource.data.keys().hasOnly(['studentId', 'sectionId'])
          && adviser(school, request.resource.data.sectionId)
          && !exists(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(request.resource.data.studentId))
          && getAfter(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(request.resource.data.studentId)).data.studentNumber == number
          && getAfter(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(request.resource.data.studentId)).data.sectionId == request.resource.data.sectionId
          && getAfter(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(request.resource.data.studentId)).data.createdBy == request.auth.uid
          && device(school, getAfter(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(request.resource.data.studentId)).data.deviceId);
      }
      match /sparkAttendance/{key} {
        function validAttendance(d) {
          let student = get(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(d.studentId)).data;
          return d.keys().hasOnly(['eventUuid', 'studentId', 'sectionId', 'teacherId', 'deviceId', 'source', 'cardId', 'subjectId', 'attendanceTag', 'eventType', 'localSchoolDate', 'localTimestamp', 'timezone', 'smsExpectedCount', 'receivedAt'])
            && text(d.eventUuid, 120) && student.status == 'ACTIVE' && student.sectionId == d.sectionId
            && d.teacherId == request.auth.uid && section(school, d.sectionId) && device(school, d.deviceId)
            && ((d.get('subjectId', '') != '' && subjectTeacher(school, d.subjectId, d.sectionId) && d.attendanceTag in ['ON_TIME', 'LATE', 'ABSENT'] && ((d.attendanceTag == 'ABSENT' && d.eventType == 'ABSENT') || (d.attendanceTag in ['ON_TIME', 'LATE'] && d.eventType == 'ARRIVAL')))
              || (d.get('subjectId', '') == '' && adviser(school, d.sectionId)))
            && d.eventType in ['ARRIVAL', 'ABSENT', 'DISMISSAL', 'CUSTOM'] && d.localSchoolDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && iso(d.localTimestamp) && d.timezone == get(/databases/$(database)/documents/schools/$(school)).data.timeZone
            && d.smsExpectedCount is int && d.smsExpectedCount >= 0 && d.smsExpectedCount <= 5 && d.receivedAt == request.time
            && (key == school + '|' + d.studentId + '|' + d.localSchoolDate + '|' + d.eventType || (d.source == 'MANUAL' && key == school + '|' + d.studentId + '|' + d.localSchoolDate + '|ROLLCALL|' + d.eventUuid) || (d.source == 'MANUAL' && d.get('subjectId', '') != '' && key == school + '|' + d.studentId + '|' + d.localSchoolDate + '|' + d.subjectId + '|ROLLCALL|' + d.eventUuid))
            && (!(d.source == 'MANUAL' && d.eventType == 'DISMISSAL') || key == school + '|' + d.studentId + '|' + d.localSchoolDate + '|DISMISSAL')
            && ((d.source == 'MANUAL' && d.eventType in ['ARRIVAL', 'ABSENT'] && d.cardId == null) || (d.source == 'MANUAL' && d.eventType == 'DISMISSAL' && d.cardId == null && adviser(school, d.sectionId) && get(/databases/$(database)/documents/schools/$(school)/sparkDismissals/$(d.sectionId + '_' + d.localSchoolDate)).data.deviceId == d.deviceId && get(/databases/$(database)/documents/schools/$(school)/sparkDismissals/$(d.sectionId + '_' + d.localSchoolDate)).data.teacherId == request.auth.uid && d.localTimestamp == get(/databases/$(database)/documents/schools/$(school)/sparkDismissals/$(d.sectionId + '_' + d.localSchoolDate)).data.localTimestamp && d.studentId in get(/databases/$(database)/documents/schools/$(school)/sparkDismissals/$(d.sectionId + '_' + d.localSchoolDate)).data.studentIds)
              || (d.source == 'NFC' && d.eventType != 'ABSENT' && d.cardId is string && get(/databases/$(database)/documents/schools/$(school)/nfcCards/$(d.cardId)).data.status == 'ACTIVE'
                && get(/databases/$(database)/documents/schools/$(school)/nfcCards/$(d.cardId)).data.studentId == d.studentId));
        }
        allow get: if teacher(school) && (!exists(/databases/$(database)/documents/schools/$(school)/sparkAttendance/$(key)) || adviser(school, resource.data.sectionId) || resource.data.teacherId == request.auth.uid);
        allow list: if teacher(school) && (resource.data.teacherId == request.auth.uid || adviser(school, resource.data.sectionId));
        allow create: if teacherWrite(school) && validAttendance(request.resource.data);
      }
      match /sparkSms/{id} {
        function validSms(d) {
          let a = get(/databases/$(database)/documents/schools/$(school)/sparkAttendance/$(d.attendanceKey)).data;
          let student = get(/databases/$(database)/documents/schools/$(school)/sparkStudents/$(d.studentId)).data;
          return d.keys().hasOnly(['attendanceKey', 'attendanceEventId', 'studentId', 'sectionId', 'guardianId', 'teacherId', 'deviceId', 'status', 'attemptCount', 'sentAt', 'deliveredAt', 'lastErrorCode', 'updatedAt'])
            && section(school, d.sectionId) && device(school, d.deviceId) && d.teacherId == request.auth.uid
            && a.eventUuid == d.attendanceEventId && a.studentId == d.studentId && a.sectionId == d.sectionId && a.teacherId == d.teacherId && a.deviceId == d.deviceId
            && student.parentPhoneVerified == true && student.parentConsent == true && d.guardianId == d.studentId + '_parent'
            && d.status in ['QUEUED', 'SENDING', 'SENT', 'DELIVERED', 'FAILED_RETRYABLE', 'FAILED_FINAL', 'CANCELLED']
            && d.attemptCount is int && d.attemptCount >= 0 && d.attemptCount <= 8
            && nullableIso(d.sentAt) && nullableIso(d.deliveredAt) && (d.lastErrorCode == null || text(d.lastErrorCode, 120)) && d.updatedAt == request.time;
        }
        allow get: if teacher(school) && (!exists(/databases/$(database)/documents/schools/$(school)/sparkSms/$(id)) || adviser(school, resource.data.sectionId) || resource.data.teacherId == request.auth.uid);
        allow list: if teacher(school) && (adviser(school, resource.data.sectionId) || resource.data.teacherId == request.auth.uid);
        allow create: if teacherWrite(school) && validSms(request.resource.data);
        allow update: if teacherWrite(school) && validSms(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attemptCount', 'sentAt', 'deliveredAt', 'lastErrorCode', 'updatedAt'])
          && request.resource.data.attemptCount >= resource.data.attemptCount;
      }
    }
  }
}
